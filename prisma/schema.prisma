// This is the Prisma schema for MongoDB Atlas
// Run: npx prisma generate
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  USER
}

// ─────────────────────────────────────────────────────────────
// Form Submissions (analytics + lead management)
// ─────────────────────────────────────────────────────────────

model FormSubmission {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  type      FormType
  name      String
  email     String
  phone     String
  data      Json       // flexible extra fields (date, slot, message, role, resumeUrl etc.)
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum FormType {
  APPOINTMENT
  CALLBACK
  CONTACT
  CAREERS
}

enum LeadStatus {
  NEW
  REVIEWED
  CONTACTED
  CLOSED
}

// ─────────────────────────────────────────────────────────────
// Appointment Management
// ─────────────────────────────────────────────────────────────

model Appointment {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  aptId       String       @unique // APT-0001 human-readable ID
  patientName String
  phone       String
  email       String?
  doctor      String?
  department  String?
  date        String       // YYYY-MM-DD
  time        String       // e.g. "10:00 AM"
  type        String       @default("In-Person")
  reason      String?
  status      AptStatus    @default(PENDING)
  adminNotes  String?
  history     AptHistory[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([date])
}

model AptHistory {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String      @db.ObjectId
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  action        String
  fromStatus    AptStatus?
  toStatus      AptStatus?
  note          String?
  changedBy     String
  createdAt     DateTime    @default(now())
}

enum AptStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────────────────────
// Hospital Content
// ─────────────────────────────────────────────────────────────

model Doctor {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique
  name          String
  role          String
  image         String
  imagePosition String?
  qualification String?
  experience    String?
  languages     String?
  availability  String?
  highlight     String?
  specialties   String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Treatment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  name        String
  image       String
  badge       String?
  highlight   String?
  description String
  benefits    String[]
  duration    String
  category    String   // dental | aesthetics | hair
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Specialty {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  name        String
  image       String
  highlight   String?
  description String
  benefits    String[]
  duration    String
  badge       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  image       String
  excerpt     String?
  content     String?
  publishedAt DateTime @default(now())
  isActive    Boolean  @default(true)
}

model Testimonial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  initials    String
  avatarColor String
  rating      Int
  date        String
  review      String
  tag         String
  specialty   String
  platform    String
  verified    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
